rules_version = '2';

// Only the backend (firebase-admin, which bypasses these rules) reads or
// writes Firestore. Clients authenticate with Firebase Auth but talk to the
// backend API, never to Firestore directly — so every collection is closed here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

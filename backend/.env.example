# Circle developer-controlled wallets
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Created once via `npm run create-wallet-set`
CIRCLE_WALLET_SET_ID=
# Any Circle-supported chain id, e.g. MATIC-AMOY (testnet), ETH-SEPOLIA, MATIC, ETH
CIRCLE_BLOCKCHAIN=MATIC-AMOY

# Firebase Admin SDK — Project Settings > Service accounts > Generate new private key,
# then paste the whole JSON file contents here as a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Encrypts/decrypts billingKeys (AES-256-GCM). 32-byte hex string — generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value or rotate it without a migration plan (existing billingKeys stop decrypting).
BILLING_KEY_SECRET=

# Server
PORT=8080
# Comma-separated list of allowed origins, e.g. http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Gateway sweep — moves USDC deposited into a card's wallet into Circle Gateway so it becomes
# chargeable via POST /platform/charge. Card wallets hold no native gas of their own, so this
# sponsor wallet pays gas for their approve+deposit transactions.
# Created once via `npm run create-gas-sponsor-wallet`, then fund its printed address with
# testnet native gas from https://faucet.circle.com. Without this set, sweeps are skipped (a
# warning is logged) and cards' gatewayBalance stays at 0.
CIRCLE_GAS_SPONSOR_WALLET_ID=
# Optional tuning — defaults shown.
# GATEWAY_SWEEP_MIN_USDC=0.01
# GATEWAY_GAS_TOPUP_THRESHOLD=0.01
# GATEWAY_GAS_TOPUP_AMOUNT=0.02
# Max fee (USDC) a withdrawal (Gateway -> card wallet) authorizes Circle to charge for processing it.
# GATEWAY_WITHDRAW_MAX_FEE=0.05

# Webhook (no env var needed — Circle stores the subscription on its side). One-time setup once this
# backend is publicly reachable over HTTPS:
#   npm run create-webhook-subscription -- https://<your-host>/webhooks/circle
# Circle then POSTs to /webhooks/circle on wallet activity, which proactively triggers the Gateway
# sweep above instead of waiting for the next GET /cards/:id/balance. See src/routes/webhooks.ts.
